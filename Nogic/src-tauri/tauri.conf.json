{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nogic",
  "version": "1.1.0",
  "identifier": "com.nogic.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nogic",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://*.tile.openstreetmap.org https://*.openstreetmap.org https://icons.duckduckgo.com data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:11434 https://nominatim.openstreetmap.org https://api.github.com; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Nogic",
    "copyright": "© 2026 Nogic. Released under the GNU GPL v3.0.",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false,
        "languages": ["English"],
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "resources": {
      "../../backend/dist/nogic-backend.exe": "nogic-backend.exe",
      "../../docs/DOCUMENTATION.md": "docs/DOCUMENTATION.md",
      "../../docs/RELEASE_NOTES.md": "docs/RELEASE_NOTES.md",
      "../../docs/LICENSES.md": "docs/LICENSES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
